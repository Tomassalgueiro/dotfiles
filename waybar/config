{
  "layer": "top",
  "position": "top",
  "margin-bottom": -5,
  "spacing" : 0,
  "height": 24,
  "modules-left": [
  "sway/workspaces",
  ],


  "modules-right": [
    "memory",
    "backlight",
    "pulseaudio",
    "battery",
    "network",
    "custom/separator",
    "clock",
  ],
  
  

  "sway/workspaces": {
        "on-click": "activate",
        "disable-scroll": true,
        "all-outputs": true,
        "show-special": true,
        "persistent-workspaces": {
            "*": [ 1, 2, 3, 4 ],
        },
    },


  "clock": {
    "timezone": "Europe/Lisbon",
    "tooltip": false,
    "format": "{:%a %d - %H:%M}",
    "interval": 1
  },

  "network": {
    "format-wifi": "<span color='#9ece6a'>conn</span>",
    "format-ethernet": "<span color='#9ece6a'>conn</span>",
    "format-disconnected": "<span color='#ff5555'>disc</span>",
    "interval": 5,
    "tooltip-format": "{essid} ({signalStrength}%)",
    "on-click": "alacritty -e nmtui"

 },

  "memory": {
    "interval": 30,
   "format": "<span color='#7aa2f7'>mem:</span> {used:0.1f}G/{total:0.1f}G",
    "tooltip-format": "Memory"
  },

  
  "backlight": {
        "format": "<span color='#ff9e64'>bright:</span> {percent}%",
        "tooltip": false
  },
  
  "pulseaudio": {
    "format": "<span color='#f7768e'>vol:</span> {volume}%",
    "format-muted": "<span color='#f7768e'>muted</span>",
    "on-click": "pavucontrol"
  },

  "battery": {
        "interval":2,
        "format": "<span color='#f9c74f'>bat (d):</span> {capacity}%",
        "format-charging": "<span color='#73daca'>bat (c):</span> {capacity}%",
  },
  
  "custom/separator": {
    	"format": "{|}",
  },
}

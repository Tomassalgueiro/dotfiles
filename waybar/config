{
  "layer": "top",
  "position": "top",
  "margin-bottom": 3,
  "margin-top": 0,
  "spacing" : 0,
  "height": 24,
  "modules-left": [
  "sway/workspaces",
  ],


  "modules-right": [
    "sway/window",
    "custom/vpn",
    "custom/music",
    "network",
    "bluetooth",
    "backlight",
    "pulseaudio",
    "battery",
    "custom/separator",
    "clock",
    "tray",
  ],
  
  "sway/workspaces": {
        "on-click": "activate",
        "disable-scroll": true,
        "all-outputs": true,
        "show-special": true,
        "persistent-workspaces": {
            "*": [ 1, 2, 3, 4 ],
        },
    },

  "sway/window": {
	"format": "{title}",
  	"max-length": 80,
	"separate-outputs": false,
	"rewrite": {
		"(.+)": "$1 |",
		"^$": "void |",
	}
  },


  "clock": {
    "timezone": "Europe/Lisbon",
    "tooltip": true,
    "format": "{:%a, %d - %H:%M}", 
    "tooltip-format": "{:%A, %d %B %Y, %H:%M:%S}",
    "interval": 10,
    "on-click": "alacritty -e fish -c 'cal -y; exec fish'",
  },

  "custom/music": {
    "format": "{}",
    "interval": 5,
    "tooltip": false,
    "exec": "playerctl metadata --format='{{ artist }} - {{ title }}'",
    "on-click": "playerctl play-pause",
    "exec": "$HOME/.config/waybar/scripts/playerctlstatus.sh"
  },


  "network": {
    "format-wifi": "󰤥",
    "format-ethernet": "<span color='#9ece6a'>󰈁</span>",
    "format-disconnected": "<span color='#ff5555'>󰤮</span>",
    "interval": 5,
    "tooltip-format": "{essid} ({signalStrength}%)",
    "on-click": "alacritty -e nmtui"

 },

  "memory": {
   "interval": 30,
   "format": "<span color='#7aa2f7'>mem:</span> {used:0.1f}G/{total:0.1f}G",
   "tooltip-format": "Memory",
   "on-click": "alacritty -e btop"
  },

  
  "backlight": {
        "format": "{icon}",	
	"tooltip": true,
	"tooltip-format": "Brightness: {percent}%",
	"format-icons": ["󰃞", "󰃟", "󰃠"]
  },
  
  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "",
    "format-icons": {
      "default": ["", "", ""]
    },
    "on-click": "pavucontrol",
    "tooltip": true,
    "tooltip-format": "Volume: {volume}%",
  },

  "battery": {
        "interval":2,
	"states": {
		"warning":30,
		"critical":15,
	},
	"events": {
		"on-discharging-warning": "notify-send -u normal 'Low Battery'",
		"on-discharging-critical": "notify-send -u critical 'Very Low Battery'",
		"on-charging-100": "notify-send -u normal 'Battery Full!'"
        },
	"format": "{icon}",
        "format-charging": "󰂄",
        "format-plugged": "󰂄",
        "format-full": "󰁹",
	"format-warning":"󱈸󰁼",
	"format-critical":"󰂃",
	"tooltip": true,
	"tooltip-format": "Battery: {capacity}%",
	"format-icons": ["󰁺","󰁼","󰁾","󰂀","󰂂"],
	"format-icons-charging": {},
  },

  
  "custom/separator": {
    	"format": "|",
  },

  "tray": {
	"spacing": 10,
	"hidden-icons": {
	  "network": true
	}
  },

  "bluetooth": {
    "format": "󰂲",
    "format-on": "{icon}",
    "format-off": "{icon}", 
    "format-connected":"{icon}",
    "format-icons":{
        "on":"󰂯",
        "off": "󰂲",
        "connected": "󰂰",
        },
    "on-click": "alacritty -e bluetui",
    "on-click-right": "~/.config/waybar/scripts/bluetooth_off_and_on.sh",
    "tooltip-format-connected":"{device_enumerate}"
  },

    "custom/vpn": {
    "format": "{}",
    "interval": 2,
    "on-click": "~/.config/waybar/scripts/tailscale_toggle.sh",
    "exec": "~/.config/waybar/scripts/tailscale_status.sh",
    "tooltip": false
    }
}

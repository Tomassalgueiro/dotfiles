
#font=JetBrains Mono 12 
font=CaskaydiaCove Nerd Font 12

format=<b>%a </b>\n%s\n%b

sort=-time
layer=overlay
anchor=top-right

background-color=#24283b
text-color=#cdd6f4
progress-color= over #B97CDE33
width=300
height=140

margin= 10,10,0,0
padding=0,5,10

border-size=2
border-color=#6046ad 
